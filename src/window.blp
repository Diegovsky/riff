using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  default-width: 1080;
  default-height: 720;

  $ShellBox {
    // Keep in sync with pages/shortcuts/shortcuts.blp
    ShortcutController {
      scope: local;

      Shortcut {
        trigger: "space";
        action: "action(app.toggle_playback)";
      }

      Shortcut {
        trigger: "<Ctrl>Q";
        action: "action(app.quit)";
      }

      Shortcut {
        trigger: "<Ctrl>bracketleft";
        action: "action(app.player_prev)";
      }

      Shortcut {
        trigger: "<Ctrl>bracketright";
        action: "action(app.player_next)";
      }

      Shortcut {
        trigger: "<Ctrl>S";
        action: "action(app.toggle_shuffle)";
      }

      Shortcut {
        trigger: "<Ctrl>R";
        action: "action(app.toggle_repeat)";
      }

      Shortcut {
        trigger: "<Ctrl>M";
        action: "action(app.toggle_mute)";
      }

      Shortcut {
        trigger: "<Alt>1";
        action: "action(app.nav_now_playing)";
      }

      Shortcut {
        trigger: "<Alt>2";
        action: "action(app.nav_artists)";
      }

      Shortcut {
        trigger: "<Alt>3";
        action: "action(app.nav_albums)";
      }

      Shortcut {
        trigger: "<Alt>4";
        action: "action(app.nav_playlists)";
      }

      Shortcut {
        trigger: "<Alt>5";
        action: "action(app.nav_tracks)";
      }

      Shortcut {
        trigger: "F9";
        action: "action(win.show-navigation-panel)";
      }

      Shortcut {
        trigger: "<Alt>Left";
        action: "action(app.nav_pop)";
      }

      Shortcut {
        trigger: "<Ctrl>F";
        action: "action(app.search)";
      }
    }

    ShortcutController arrow_shortcuts {
      scope: local;
      propagation-phase: capture;

      Shortcut {
        trigger: "<Ctrl>Left";
        action: "action(app.seek_backward)";
      }

      Shortcut {
        trigger: "<Ctrl>Right";
        action: "action(app.seek_forward)";
      }

      Shortcut {
        trigger: "<Ctrl>Down";
        action: "action(app.volume_down)";
      }

      Shortcut {
        trigger: "<Ctrl>Up";
        action: "action(app.volume_up)";
      }

      Shortcut {
        trigger: "<Ctrl><Shift>Left";
        action: "action(app.player_prev)";
      }

      Shortcut {
        trigger: "<Ctrl><Shift>Right";
        action: "action(app.player_next)";
      }
    }

    Adw.ToastOverlay toast_overlay {
      vexpand: true;

      // Bottom sheet
      Adw.BottomSheet bottom_sheet {
        reveal-bottom-bar: false;
        // Narrow windows only. Beside the content, the queue isn't in the
        // sheet: the bar shows the current track and doesn't open
        bottom-bar: $QueueBarWidget queue_bar {
          height-request: 36;
        };
        full-width: false;

        // Dropped by the narrow breakpoints (see shell/layout)
        styles [
          "bottom-sheet--padded",
        ]

        content: Adw.OverlaySplitView utility_split {
          sidebar-position: end;
          show-sidebar: false;
          pin-sidebar: true;
          sidebar-width-unit: px;
          // The bottom sheet's bottom bar is over the content: the content
          // ends above it
          margin-bottom: bind bottom_sheet.bottom-bar-height;

          // An OverlaySplitView collapses without reparenting its children,
          // which would rebuild every page
          content: Adw.OverlaySplitView navigation_split {
            vexpand: true;
            pin-sidebar: true;
            sidebar-width-unit: px;

            // Navigation panel
            sidebar: Box navigation_panel {
              Box {
                orientation: vertical;
                hexpand: true;

                Adw.HeaderBar navigation_panel_header {
                  styles [
                    "flat",
                  ]

                  Button search_button {
                    icon-name: "system-search-symbolic";
                    tooltip-text: _("Search");
                    focus-on-click: false;
                    can-focus: false;
                  }

                  [title]
                  Adw.WindowTitle {
                    title: "Riff";
                  }

                  [end]
                  MenuButton user {
                    icon-name: "open-menu-symbolic";
                    tooltip-text: _("Main Menu");
                    // Opens with F10
                    primary: true;
                    focus-on-click: false;
                    can-focus: false;
                  }
                }

                ScrolledWindow {
                  hscrollbar-policy: never;

                  ListBox home_listbox {
                    vexpand: true;

                    styles [
                      "navigation-sidebar",
                    ]
                  }
                }
              }

              // The drag itself is on the split view (see shell/layout)
              Box navigation_resize_handle {
                width-request: 6;

                styles [
                  "navigation-panel__resize-handle",
                ]
              }
            };

            // Content panel. In a ClipBin, so the panels are never squeezed
            // for it while they slide (see shell/layout/clip_bin.rs)
            content: $ClipBin {
              child: Box content_panel {
                orientation: vertical;

                $AppHeaderBar app_header {}

                Stack content_stack {
                  hexpand: true;
                  vexpand: true;
                  transition-type: slide_left_right;
                }
              };
            };
          };

          // Utility panel
          sidebar: $UtilityPanelWidget utility_panel {};
        };
      }
    }

    // Playback bar, with the selection toolbar over it
    Overlay {
      hexpand: true;

      $PlaybackWidget playback {
        hexpand: true;
        vexpand: false;
      }

      [overlay]
      $SelectionToolbarWidget selection_toolbar {
        hexpand: true;
      }
    }
  }
}

Adw.AboutDialog about {
  application-name: "Riff";
  application-icon: "dev.diegovsky.Riff";
  developer-name: "The Riff Team";
  website: "https://github.com/Diegovsky/riff";
  support-url: "https://discord.gg/rAAvFSC7VQ";
  issue-url: "https://github.com/Diegovsky/riff/issues";
  license-type: mit_x11;
}

menu main_menu {
  section {
    item {
      label: _("Preferences");
      action: "win.preferences";
    }

    item {
      label: _("Keyboard Shortcuts");
      action: "win.show-shortcuts";
    }

    item {
      label: _("Report Issue");
      action: "menu.report-issue";
    }

    item {
      label: _("About Riff");
      action: "menu.about";
    }
  }

  section {
    item {
      label: _("Log Out");
      action: "menu.logout";
    }

    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}
