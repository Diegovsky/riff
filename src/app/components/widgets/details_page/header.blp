using Gtk 4.0;
using Adw 1;

template $DetailsHeaderWidget : Widget {
  valign: start;

  styles [
    "details-header",
  ]

  Adw.BreakpointBin breakpoint_bin {
    width-request: 1;
    height-request: 1;
    hexpand: true;

    // Narrow: stack artwork above the text/buttons instead of beside them.
    Adw.Breakpoint {
      condition("max-width: 510sp")

      setters {
        header_box.orientation: vertical;
        image_box.halign: center;
        image_box.valign: start;
        image_box.margin-end: 0;
        image_box.margin-bottom: 8;
        // Remove the desktop-only top padding so the text/buttons stack tightly.
        info_box.margin-top: 0;
      }
    }

    child: Box header_box {
      orientation: horizontal;

      Box image_box {
        overflow: hidden;
        valign: center;
        margin-end: 12;
        width-request: 200;
        height-request: 200;

        styles [
          "details-header__image-box",
        ]

        Overlay {
          Picture image {
            content-fit: cover;

            styles [
              "details-header__image",
            ]
          }

          [overlay]
          Button info_button {
            icon-name: "preferences-system-details-symbolic";
            tooltip-text: _("Details");
            halign: end;
            valign: end;
            visible: false;
            can-target: true;
            margin-end: 4;
            margin-bottom: 4;

            styles [
              "circular",
              "info__button",
            ]
          }
        }
      }

      Box content_box {
        orientation: vertical;
        hexpand: true;
        // Don't propagate the spacers' vexpand: stay at natural height in the
        // narrow (vertical) layout instead of the desktop artwork height.
        vexpand: false;

        // Spacers only expand on desktop (box stretched to artwork height),
        // centering text and pushing buttons down. In the narrow layout they
        // collapse to zero so everything stacks tightly.
        Box {
          vexpand: true;
        }

        Box info_box {
          orientation: vertical;
          hexpand: true;
          // Top padding set to the height of the action buttons below, so the
          // centered text block accounts for the button row and sits optically
          // centered against the artwork on desktop. Reset to 0 by the narrow
          // breakpoint, where the layout stacks vertically.
          margin-top: 34;

          Label caption_label {
            halign: start;
            visible: false;

            styles [
              "caption",
            ]
          }

          Label title_label {
            halign: start;
            hexpand: false;
            ellipsize: end;

            styles [
              "title-1",
              "details-header__title",
            ]
          }

          Label subtitle_label {
            halign: start;
            visible: false;
            ellipsize: end;

            styles [
              "body",
            ]
          }

          $SubtitleLinksBox subtitle_links_box {
            halign: start;
            visible: false;

            styles [
              "body",
            ]
          }
        }

        Box {
          vexpand: true;
        }

        Box button_box {
          orientation: horizontal;
          spacing: 8;
          hexpand: true;
          margin-top: 12;

          Button play_button {
            icon-name: "media-playback-start-symbolic";
            halign: center;
            valign: center;
            visible: false;
            tooltip-text: _("Play");

            styles [
              "circular",
              "play__button",
            ]
          }

          Button shuffle_button {
            icon-name: "media-playlist-shuffle-symbolic";
            halign: center;
            valign: center;
            visible: false;
            tooltip-text: _("Shuffle");

            styles [
              "circular",
              "shuffle__button",
            ]
          }

          Button like_button {
            icon-name: "non-starred-symbolic";
            halign: center;
            valign: center;
            visible: false;
            tooltip-text: _("Add to Library");

            styles [
              "circular",
              "like__button",
            ]
          }

          Button share_button {
            icon-name: "folder-publicshare-symbolic";
            halign: center;
            valign: center;
            visible: false;
            tooltip-text: _("Copy Link");

            styles [
              "circular",
              "share__button",
            ]
          }

          Button pin_button {
            icon-name: "pin-symbolic";
            halign: center;
            valign: center;
            visible: false;
            tooltip-text: _("Pin");

            styles [
              "circular",
              "pin__button",
            ]
          }

          Box {
            hexpand: true;
          }

          Button edit_button {
            icon-name: "document-edit-symbolic";
            halign: center;
            valign: center;
            visible: false;
            tooltip-text: _("Edit");

            styles [
              "circular",
              "edit__button",
            ]
          }
        }
      }
    };
  }
}
