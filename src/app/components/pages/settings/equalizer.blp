        vexpand: true;
        adjustment: Adjustment {
          lower: -12.0;
          upper: 12.0;
          value: 0.0;
          step-increment: 0.5;
          page-increment: 1.0;
        };
        marks [
          mark (0, right, ""),
        ]
      }

      Label {
        label: _("250");
        styles [ "caption", "dim-label" ]
      }
    }

    Gtk.Box {
      orientation: vertical;
      spacing: 4;

      Scale eq_band_4 {
        orientation: vertical;
        inverted: true;
        draw-value: true;
        value-pos: bottom;
        digits: 1;
        round-digits: 1;
        vexpand: true;
        adjustment: Adjustment {
          lower: -12.0;
          upper: 12.0;
          value: 0.0;
          step-increment: 0.5;
          page-increment: 1.0;
        };
        marks [
          mark (0, right, ""),
        ]
      }

      Label {
        label: _("500");
        styles [ "caption", "dim-label" ]
