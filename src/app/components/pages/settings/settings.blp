using Gtk 4.0;
using Adw 1;

template $SettingsWindow : Adw.PreferencesDialog {
  search-enabled: false;

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      /* Translators: Header for a group of preference items regarding the application's appearance and behavior */

      title: _("General");

      Adw.ComboRow theme {
        /* Translators: Title for an item in preferences */

        title: _("Theme");
        model: StringList {
          strings [
            _("Light"),
            _("Dark"),
            _("System")
          ]
        };
      }

      Adw.ComboRow close_behavior {
        /* Translators: Title for an item in preferences */

        title: _("Close Window Behavior");

        /* Translators: Description for the close window behavior preference */

        subtitle: _("What should Riff do if you close it while audio is playing?");
        model: StringList {
          strings [
            _("Ask"),
            _("Continue in Background"),
            _("Stop and Quit")
          ]
        };
      }

      Adw.SwitchRow inhibit_suspend_switch {
        /* Translators: Title for the keep device awake toggle in preferences */

        title: _("Keep Device Awake While Playing");

        /* Translators: Description for the keep device awake toggle */

        subtitle: _("Prevent the system from automatically suspending while audio is playing");
      }

      Adw.SwitchRow skip_explicit_switch {
        /* Translators: Title for the skip explicit tracks toggle in preferences */

        title: _("Skip Explicit Tracks");

        /* Translators: Description for the skip explicit tracks toggle */

        subtitle: _("Automatically skip tracks marked as explicit");
      }
    }

    Adw.PreferencesGroup {
      /* Translators: Header for a group of preference items regarding audio */

      title: _("Audio");

      Adw.ComboRow audio_backend {
        /* Translators: Title for an item in preferences */

        title: _("Audio Backend");
        model: StringList {
          strings [
            "PulseAudio",
            "ALSA"
          ]
        };
      }

      Adw.ActionRow alsa_device_row {
        /* Translators: Title for an item in preferences */

        title: _("ALSA Device");

        /* Translators: Description for the item (ALSA Device) in preferences */

        subtitle: _("Applied only if audio backend is ALSA");

        Entry alsa_device {
          valign: center;
        }
      }

      Adw.ComboRow player_bitrate {
        /* Translators: Title for an item in preferences */

        title: _("Audio Quality");
        subtitle: _("Streaming bitrate from Spotify (higher uses more bandwidth)");
        model: StringList {
          strings [
            _("Normal"),
            _("High"),
            _("Very High"),
            _("Lossless"),
          ]
        };
      }

      Adw.ComboRow audio_format {
        title: _("Audio Format");
        subtitle: _("Sample bit depth for audio output");
        model: StringList {
          strings [
            "S16 (16-bit)",
            "S24 (24-bit)",
            "S24_3 (24-bit packed)",
            "S32 (32-bit)",
            "F32 (32-bit float)",
            "F64 (64-bit float)",
          ]
        };
      }

      Adw.ActionRow gapless_playback {
        /* Translators: Title for an item in preferences */

        title: _("Gapless Playback");
        subtitle: _("Eliminates silence between consecutive tracks");
        name: "gapless_playback_row";
        activatable-widget: gapless_playback_switch;
        visible: true;

        Switch gapless_playback_switch {
          margin-top: 12;
          margin-bottom: 12;
        }
      }

      Adw.ComboRow volume_curve {
        title: _("Volume Curve");
        subtitle: _("Controls how the volume slider responds");
        model: StringList {
          strings [
            _("Logarithmic"),
            _("Linear"),
            _("Cubic"),
          ]
        };
      }

      Adw.SwitchRow mono_audio_switch {
        title: _("Mono Audio");
        subtitle: _("Mix left and right channels together so both speakers play the same audio");
      }

    }

    Adw.PreferencesGroup normalisation_group {
      title: _("Normalisation");
      description: _("Adjust volume levels between tracks for consistent loudness");

      Adw.SwitchRow normalisation_switch {
        title: _("Enable Normalisation");
        subtitle: _("Automatically adjust volume between tracks");
      }

      Adw.ComboRow normalisation_type {
        title: _("Normalisation Type");
        subtitle: _("How gain values are selected");
        sensitive: bind normalisation_switch.active;
        model: StringList {
          strings [
            _("Auto"),
            _("Track"),
            _("Album"),
          ]
        };
      }

      Adw.ComboRow normalisation_method {
        title: _("Normalisation Method");
        subtitle: _("Basic clips peaks, Dynamic uses a limiter");
        sensitive: bind normalisation_switch.active;
        model: StringList {
          strings [
            _("Dynamic"),
            _("Basic"),
          ]
        };
      }

      Adw.SpinRow normalisation_pregain {
        title: _("Pre-gain (dB)");
        subtitle: _("Additional gain applied before normalisation");
        sensitive: bind normalisation_switch.active;
        adjustment: Adjustment {
          lower: -10.0;
          upper: 10.0;
          value: 0.0;
          step-increment: 0.5;
          page-increment: 1.0;
        };
      }

      Adw.SpinRow normalisation_threshold {
        title: _("Threshold (dBFS)");
        subtitle: _("Ceiling for dynamic normalisation");
        sensitive: bind normalisation_switch.active;
        adjustment: Adjustment {
          lower: -10.0;
          upper: 0.0;
          value: -2.0;
          step-increment: 0.5;
          page-increment: 1.0;
        };
      }

      Adw.SpinRow normalisation_attack {
        title: _("Attack (ms)");
        subtitle: _("How quickly the limiter reacts to peaks");
        sensitive: bind normalisation_switch.active;
        adjustment: Adjustment {
          lower: 1.0;
          upper: 500.0;
          value: 5.0;
          step-increment: 1.0;
          page-increment: 10.0;
        };
      }

      Adw.SpinRow normalisation_release {
        title: _("Release (ms)");
        subtitle: _("How quickly the limiter recovers after peaks");
        sensitive: bind normalisation_switch.active;
        adjustment: Adjustment {
          lower: 1.0;
          upper: 1000.0;
          value: 100.0;
          step-increment: 5.0;
          page-increment: 50.0;
        };
      }

      Adw.SpinRow normalisation_knee {
        title: _("Knee (dB)");
        subtitle: _("Width of the soft knee for the limiter");
        sensitive: bind normalisation_switch.active;
        adjustment: Adjustment {
          lower: 0.0;
          upper: 10.0;
          value: 5.0;
          step-increment: 0.5;
          page-increment: 1.0;
        };
      }
    }

    $EqualizerWidget equalizer {}

    $PanWidget pan {}

    $PitchWidget pitch {}

    Adw.PreferencesGroup {
      /* Translators: Header for a group of preference items regarding network */

      title: _("Network");

      Adw.ActionRow {
        /* Translators: Title for an item in preferences */

        title: _("Access Point Port");

        /* Translators: Longer description for an item (Access Point Port) in preferences */

        subtitle: _("Port used for connections to Spotify’s Access Point. Set to 0 if any port is fine.");

        Entry ap_port {
          valign: center;
        }
      }
    }
  }
}
