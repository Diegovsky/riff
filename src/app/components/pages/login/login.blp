using Gtk 4.0;
using Adw 1;


template $LoginWindow : Adw.Window {
  default-width: 360;
  default-height: 100;

  styles ["login-window"]

  Box {
    hexpand: true;
    margin-bottom: 24;
    orientation: vertical;

    Adw.HeaderBar {
      [title]
      Label {}

      styles ["flat"]
    }

    WindowHandle {

      Adw.Clamp {
        maximum-size: 360;
        tightening-threshold: 280;

        Box {
          hexpand: true;
          orientation: vertical;
          margin-start: 16;
          margin-end: 16;
          spacing: 24;

          Image {
            icon-name: "dev.diegovsky.Riff";
            pixel-size: 128;
            margin-bottom: 12;
          }

          Box {
            hexpand: true;
            orientation: vertical;
            spacing: 4;

            Label {
              label: _("Welcome to Riff");
              halign: center;
              styles ["title-1"]
            }

            Label {
              /* Translators: Login window subtitle */
              label: _("Log in with your Spotify Account");
              wrap: true;
              wrap-mode: word;
              halign: center;
              justify: center;
              styles ["body"]
            }
          }

          /* Status area: shows either the premium notice or an auth error, never both */
          Stack status_stack {
            transition-type: crossfade;
            transition-duration: 200;

            StackPage {
              name: "notice";
              child: Box {
                orientation: horizontal;
                halign: center;
                spacing: 8;

                Image {
                  icon-name: "dialog-warning-symbolic";
                  pixel-size: 16;
                  valign: center;
                  styles ["warning"]
                }

                Label {
                  /* Translators: Premium requirement notice shown on the login page. */
                  label: _("A Spotify Premium subscription is required.");
                  styles ["caption", "warning"]
                }
              };
            }

            StackPage {
              name: "error";
              child: Box {
                orientation: horizontal;
                halign: center;
                spacing: 8;

                Image {
                  icon-name: "dialog-warning-symbolic";
                  pixel-size: 16;
                  valign: center;
                  styles ["error"]
                }

                Label {
                  /* Translators: This error is shown when a non-premium account is detected. */
                  label: _("Your account does not have a Spotify Premium subscription.");
                  styles ["caption", "error"]
                }
              };
            }

            StackPage {
              name: "login_error";
              child: Box {
                orientation: horizontal;
                halign: center;
                spacing: 8;

                Image {
                  icon-name: "dialog-error-symbolic";
                  pixel-size: 16;
                  valign: center;
                  styles ["error"]
                }

                Label {
                  /* Translators: This error is shown when login fails due to a network or API error. */
                  label: _("Login failed. Please check your connection and try again.");
                  styles ["caption", "error"]
                }
              };
            }
          }

          Button login_with_spotify_button {
            /* Translators: Log in button label */
            label: _("Log in with Spotify...");
            halign: center;
            styles ["pill", "suggested-action"]
          }
        }
      }
    }
  }
}
