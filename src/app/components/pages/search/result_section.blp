using Gtk 4.0;
using Adw 1;

template $ResultSection : Adw.Bin {
  Expander {
    margin-start: 4;
    margin-end: 4;
    expanded: true;
    vexpand: false;
    valign: start;

    ScrolledWindow {
      vscrollbar-policy: never;
      propagate-natural-height: false;
      FlowBox flow_box {
        halign: start;
        hexpand: true;
        vexpand: false;
        valign: start;
        orientation: vertical;
        max-children-per-line: 1;
        selection-mode: none;
        activate-on-single-click: true;
      }
    }

    [label]
    Label {
      label: bind template.label;
    }
  }
}
