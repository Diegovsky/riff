using Gtk 4.0;
using Adw 1;

template $QueuePageWidget : Adw.Bin {
  child: Box {
    orientation: vertical;

    CenterBox selection_bar {
      visible: false;

      styles [
        "toolbar",
        "queue-page__selection-bar",
      ]

      [start]
      Button selection_cancel {
        /* Translators: Button label. Exits selection mode. */
        label: _("Cancel");
      }

      [center]
      Label selection_count {
        ellipsize: end;

        styles [
          "heading",
        ]
      }

      [end]
      Button select_all {
        /* Translators: Button label. Selects all visible songs. */
        label: _("Select All");
      }
    }

    Stack queue_stack {
      vexpand: true;

      styles [
        "queue-page__content",
      ]

      StackPage {
        name: "list";

        child: ScrolledWindow queue_scroller {
          hscrollbar-policy: never;
          vexpand: true;
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "queue-symbolic";
          /* Translators: Shown in place of the queue when nothing plays or is queued. */
          title: _("Nothing Queued");

          styles [
            "compact",
          ]
        };
      }
    }
  };
}
