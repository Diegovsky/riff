using Gtk 4.0;
using Adw 1;

template $AppHeaderBar : Adw.Bin {
  Overlay overlay {
    hexpand: true;

    Adw.HeaderBar main_header {
      show-end-title-buttons: true;
      show-back-button: false;

      // Flat: no background or separator, so the header blends into the content.
      styles [
        "flat",
      ]

      ToggleButton navigation_panel_toggle {
        halign: start;
        valign: center;
        icon-name: "sidebar-show-symbolic";
        action-name: "win.show-navigation-panel";
        focus-on-click: false;
        can-focus: false;

        /* Translators: Tooltip for the button that shows/hides the navigation panel. */

        tooltip-text: _("Toggle Sidebar");
      }

      Button go_back {
        receives-default: true;
        halign: start;
        valign: center;
        icon-name: "go-previous-symbolic";
        has-frame: false;
        focus-on-click: false;
        can-focus: false;
        sensitive: false;

        /* Translators: Tooltip for the header bar button that navigates back. */

        tooltip-text: _("Back");

        GestureClick back_right_click {
          button: 3;
        }

        GestureLongPress back_long_press {}
      }

      Button go_forward {
        receives-default: true;
        halign: start;
        valign: center;
        icon-name: "go-next-symbolic";
        has-frame: false;
        focus-on-click: false;
        can-focus: false;
        sensitive: false;

        /* Translators: Tooltip for the header bar button that navigates forward. */

        tooltip-text: _("Forward");

        GestureClick forward_right_click {
          button: 3;
        }

        GestureLongPress forward_long_press {}
      }

      [title]
      Stack title_stack {
        hexpand: true;
        hhomogeneous: false;

        Adw.WindowTitle window_title {}

        Adw.Bin custom_title {}
      }

      // Hidden while the utility panel shows: its header has the same button
      [end]
      ToggleButton utility_panel_button {
        icon-name: "queue-symbolic";
        /* Translators: Tooltip of the header bar button that shows or hides the utility panel with the queue. */
        tooltip-text: _("Queue");
        action-name: "win.utility-panel";
        focus-on-click: false;
        can-focus: false;
      }

      [end]
      Box end_box {
        spacing: 6;
        visible: false;
      }
    }

    [overlay]
    Adw.HeaderBar selection_header {
      show-end-title-buttons: false;
      show-start-title-buttons: false;
      visible: false;

      styles [
        "selection-mode",
      ]

      Button cancel {
        receives-default: true;
        halign: start;
        valign: center;

        /* Translators: Button label. Exits selection mode. */

        label: _("Cancel");
      }

      [title]
      Adw.WindowTitle selection_title {
        title: "";
      }

      [end]
      Button select_all {
        valign: center;

        /* Translators: Button label. Selects all visible songs. */

        label: _("Select All");
      }
    }
  }
}

// History menus, parented to go_back and go_forward in code
Popover back_history {
  has-arrow: false;

  styles [
    "menu",
    "history-menu",
  ]

  ListBox back_history_list {
    selection-mode: none;

    styles [
      "navigation-sidebar",
    ]
  }
}

Popover forward_history {
  has-arrow: false;

  styles [
    "menu",
    "history-menu",
  ]

  ListBox forward_history_list {
    selection-mode: none;

    styles [
      "navigation-sidebar",
    ]
  }
}
