using Gtk 4.0;
using Adw 1;

template $UtilityPanelWidget : Adw.Bin {
  child: Box {
    orientation: horizontal;

    // The drag itself is on the split view (see shell/layout)
    Box resize_handle {
      width-request: 6;

      styles [
        "utility-panel__resize-handle",
      ]
    }

    Adw.ToolbarView toolbar {
      hexpand: true;

      [top]
      Adw.HeaderBar header {
        show-start-title-buttons: false;

        title-widget: Adw.WindowTitle {
          /* Translators: Title of the utility panel, listing what plays next. */
          title: _("Queue");
        };

        [start]
        ToggleButton utility_panel_button {
          icon-name: "music-queue-symbolic";
          /* Translators: Tooltip of the header bar button that shows or hides the utility panel with the queue. */
          tooltip-text: _("Queue");
          action-name: "win.utility-panel";
          focus-on-click: false;
          can-focus: false;
        }
      }

      content: Stack queue_stack {
        StackPage {
          name: "list";

          child: ScrolledWindow queue_scroller {
            hscrollbar-policy: never;
            vexpand: true;
          };
        }

        StackPage {
          name: "empty";

          child: Adw.StatusPage {
            icon-name: "music-queue-symbolic";
            /* Translators: Shown in the utility panel when nothing plays or is queued. */
            title: _("Nothing Queued");

            styles [
              "compact",
            ]
          };
        }
      };
    }
  };
}
