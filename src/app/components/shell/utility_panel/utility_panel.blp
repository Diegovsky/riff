using Gtk 4.0;
using Adw 1;

template $UtilityPanelWidget : Adw.Bin {
  child: Box {
    orientation: horizontal;

    // The drag itself is on the split view (see shell/layout)
    Box resize_handle {
      width-request: 6;

      styles [
        "utility-panel__resize-handle",
      ]
    }


    Box {
      orientation: vertical;
      hexpand: true;

      Adw.HeaderBar header {
        show-start-title-buttons: false;

        styles [
          "flat",
          "utility-panel__header",
        ]

        // Set with the content (see UtilityPanel::set_content)
        title-widget: Adw.WindowTitle title {};

        [start]
        ToggleButton utility_panel_button {
          icon-name: "queue-symbolic";
          action-name: "win.utility-panel";
          focus-on-click: false;
          can-focus: false;
        }
      }

      Adw.HeaderBar selection_header {
        show-start-title-buttons: false;
        show-end-title-buttons: false;
        visible: false;

        styles [
          "flat",
          "selection-mode",
          "utility-panel__header",
        ]

        title-widget: Adw.WindowTitle selection_title {};

        [start]
        Button selection_cancel {
          valign: center;

          /* Translators: Button label. Exits selection mode. */
          label: _("Cancel");
        }

        [end]
        Button select_all {
          valign: center;

          /* Translators: Button label. Selects all visible songs. */
          label: _("Select All");
        }
      }

      // Set with UtilityPanel::set_content
      Adw.Bin content {
        vexpand: true;
      }
    }
  };
}
