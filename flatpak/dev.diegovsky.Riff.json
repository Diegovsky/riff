{
  "app-id": "dev.diegovsky.Riff",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.openjdk25"
  ],
  "command": "riff",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri"
  ],
  "separate-locales": false,
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/openjdk25/bin",
    "env": {
      "CARGO_HOME": "/run/build/riff/cargo",
      "OPENAPI_GENERATOR_JAR": "/run/build/riff/openapi-generator-cli-7.12.0.jar",
      "RUST_BACKTRACE": "full",
      "RUST_LOG": "riff=debug"
    }
  },
  "modules": [
    {
      "name": "riff",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": [
        "-Doffline=true"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        },
        {
          "type": "file",
          "url": "https://repo1.maven.org/maven2/org/openapitools/openapi-generator-cli/7.12.0/openapi-generator-cli-7.12.0.jar",
          "sha256": "33e7dfa7a1f04d58405ee12ae19e2c6fc2a91497cf2e56fa68f1875a95cbf220"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
